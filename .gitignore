__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
# generated by scripts/setup_bench2drive.sh and scripts/run_session.sh (anchored: benchmark/routes/ is tracked)
# Ignore everything fetched into third_party/, but keep the vendored Fail2Drive tree tracked. The
# glob has to be /third_party/* rather than /third_party/: git cannot re-include a path whose
# parent directory is itself excluded.
/third_party/*
!/third_party/fail2drive/
/routes/
/sessions/
# fetched into the vendored Fail2Drive tree by scripts/setup_fail2drive.sh (75 MB, see
# third_party/fail2drive/VENDORED.md); srunner reads them at runtime
/third_party/fail2drive/scenario_runner/speed_limits/*.npy
